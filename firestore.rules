rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Capture standard data shapes
    function isValidPaper(data) {
      return data.keys().hasAll(['userId', 'title', 'createdAt']) &&
             data.userId is string && data.title is string && 
             data.title.size() <= 255;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);

      match /activity/{activityId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
      }
    }

    // Papers
    match /papers/{paperId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) && isValidPaper(request.resource.data);
      allow update: if isOwner(resource.data.userId) && isValidPaper(request.resource.data);
      allow delete: if isOwner(resource.data.userId);

      // Subcollections
      match /chunks/{chunkId} {
        allow read: if isOwner(get(/databases/$(database)/documents/papers/$(paperId)).data.userId);
        allow create: if isOwner(get(/databases/$(database)/documents/papers/$(paperId)).data.userId);
      }

      match /messages/{messageId} {
        allow read: if isOwner(get(/databases/$(database)/documents/papers/$(paperId)).data.userId);
        allow create: if isOwner(get(/databases/$(database)/documents/papers/$(paperId)).data.userId);
      }
      
      match /quizzes/{quizId} {
        allow read: if isOwner(get(/databases/$(database)/documents/papers/$(paperId)).data.userId);
        allow create: if isOwner(get(/databases/$(database)/documents/papers/$(paperId)).data.userId);
      }
      
      match /flashcards/{cardId} {
        allow read: if isOwner(get(/databases/$(database)/documents/papers/$(paperId)).data.userId);
        allow create: if isOwner(get(/databases/$(database)/documents/papers/$(paperId)).data.userId);
      }
    }
    
    // Top-level quizzes and flashcards (if stored outside subcollections as well)
    match /quizzes/{quizId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    
    match /flashcards/{cardId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
  }
}
