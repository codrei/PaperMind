# GEMINI_API_KEY — server-side only. Used by api/generate.ts (the Vercel
# serverless function that proxies all Gemini calls). Set it in the Vercel
# project's Environment Variables. It is never exposed to the browser.
GEMINI_API_KEY="YOUR_KEY_HERE"

# Note: VITE_GEMINI_API_KEY is no longer used — the frontend calls
# /api/generate instead of Gemini directly, precisely so no key ships
# in the public bundle.
